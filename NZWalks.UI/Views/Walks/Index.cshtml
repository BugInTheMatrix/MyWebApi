@model IEnumerable<NZWalks.UI.Models.DTO.WalkDto>
@{
    var isWriter = NZWalks.UI.Models.JwtRoles.HasRole(
        Context.Request.Cookies[NZWalks.UI.Controllers.AuthController.TokenCookie], "Writer");
}

<h1 class="mt-3">
    Walks
</h1>
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Description
            </th>
            <th>
                Length (km)
            </th>
            <th>
                Difficulty
            </th>
            <th>
                Region
            </th>
            @if (isWriter)
            {
                <th>
                    <a class="btn btn-secondary" asp-controller="Walks" asp-action="Add">Add</a>
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var walk in Model)
        {
            <tr>
                <td>
                    @walk.Name
                </td>
                <td>
                    @walk.Description
                </td>
                <td>
                    @walk.LengthInKm
                </td>
                <td>
                    @walk.Difficulty?.Name
                </td>
                <td>
                    @walk.Region?.Name
                </td>
                @if (isWriter)
                {
                    <td class="text-nowrap">
                        <a asp-controller="Walks" asp-action="Edit" asp-route-id="@walk.Id" class="btn btn-info">Edit</a>
                        <form method="post" asp-controller="Walks" asp-action="Delete" class="d-inline"
                              data-confirm="Delete walk @walk.Name?" onsubmit="return confirm(this.dataset.confirm);">
                            <input type="hidden" name="id" value="@walk.Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
