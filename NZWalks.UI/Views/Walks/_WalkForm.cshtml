@model NZWalks.UI.Models.WalkFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
<input type="hidden" asp-for="Id" />
<div class="mt-3">
    <label class="form-label">Name</label>
    <input type="text" class="form-control" asp-for="Name" required />
</div>
<div class="mt-3">
    <label class="form-label">Description</label>
    <textarea class="form-control" asp-for="Description" rows="3" required></textarea>
</div>
<div class="mt-3">
    <label class="form-label">Length (km)</label>
    <input type="number" step="0.1" min="0" class="form-control" asp-for="LengthInKm" required />
</div>
<div class="mt-3">
    <label class="form-label">Image URL</label>
    <input type="text" class="form-control" asp-for="WalkImageUrl" />
</div>
<div class="mt-3">
    <label class="form-label">Difficulty</label>
    <select class="form-select" asp-for="DifficultyId" asp-items="ViewBag.Difficulties" required>
        <option value="">-- Select difficulty --</option>
    </select>
</div>
<div class="mt-3">
    <label class="form-label">Region</label>
    <select class="form-select" asp-for="RegionId" asp-items="ViewBag.Regions" required>
        <option value="">-- Select region --</option>
    </select>
</div>
