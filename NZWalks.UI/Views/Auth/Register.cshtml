@model NZWalks.UI.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var availableRoles = new[] { "Reader", "Writer" };
}
<h1 class="mt-3">Register</h1>

<form method="post" asp-action="Register" style="max-width: 420px">
    <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
    <div class="mt-3">
        <label class="form-label" asp-for="UserName">Email</label>
        <input type="email" class="form-control" asp-for="UserName" />
        <span class="text-danger" asp-validation-for="UserName"></span>
    </div>
    <div class="mt-3">
        <label class="form-label" asp-for="Password"></label>
        <input class="form-control" asp-for="Password" />
        <span class="text-danger" asp-validation-for="Password"></span>
    </div>
    <div class="mt-3">
        <label class="form-label d-block">Roles</label>
        @foreach (var role in availableRoles)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="Roles" id="role-@role" value="@role"
                       checked="@Model.Roles.Contains(role)" />
                <label class="form-check-label" for="role-@role">@role</label>
            </div>
        }
        <span class="text-danger d-block" asp-validation-for="Roles"></span>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Register</button>
        <a class="ms-2" asp-action="Login">Already have an account?</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
