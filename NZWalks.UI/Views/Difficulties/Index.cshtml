@model IEnumerable<NZWalks.UI.Models.DifficultyViewModel>

<h1 class="mt-3">
    Difficulties
</h1>
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                Difficulty
            </th>
            <th>
                Number of walks
            </th>
            <th>
                Walks
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var difficulty in Model)
        {
            <tr>
                <td>
                    @difficulty.Name
                </td>
                <td>
                    @difficulty.Walks.Count
                </td>
                <td>
                    @string.Join(", ", difficulty.Walks.Select(w => w.Name))
                </td>
            </tr>
        }
    </tbody>
</table>
