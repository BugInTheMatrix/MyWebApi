@model IEnumerable<NZWalks.UI.Models.DTO.RegionDto>
@{
    var isLoggedIn = Context.Request.Cookies.ContainsKey(NZWalks.UI.Controllers.AuthController.TokenCookie);
    var isWriter = NZWalks.UI.Models.JwtRoles.HasRole(
        Context.Request.Cookies[NZWalks.UI.Controllers.AuthController.TokenCookie], "Writer");
}

@if (!isLoggedIn)
{
    <div class="alert alert-info mt-3">
        Please <a asp-controller="Auth" asp-action="Login">log in</a> or
        <a asp-controller="Auth" asp-action="Register">register</a> to view regions.
    </div>
}
else
{
<h1 class="mt-3">
    Regions
</h1>
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>
            <th>
                Code
            </th>
            <th>
                <a class="btn btn-secondary" asp-controller="Regions" asp-action="Add">Add</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach(var region in Model)
        {
            <tr>
                <td>
                    @region.Id
                </td>
                <td>
                    @region.Name
                </td>
                <td>
                    @region.Code
                </td>
                <td>
                    <a asp-controller="Regions" asp-action="Edit" asp-route-id="@region.Id" class="btn btn-info">Edit</a>
                    @if (isWriter)
                    {
                        <form method="post" asp-controller="Regions" asp-action="Delete" class="d-inline"
                              data-confirm="Delete region @region.Name?" onsubmit="return confirm(this.dataset.confirm);">
                            <input type="hidden" name="Id" value="@region.Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
}
